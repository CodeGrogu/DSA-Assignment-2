# Ballerina build artifacts
target/
*.jar
*.bala
.ballerina/

# Ballerina project cache and lock files
Dependencies.toml.backup
repo/

# Configuration overrides and local secrets
Config.local.toml
*.local.toml
# Allow configuration templates to be shared across team members
!services/payment_service/Config.toml
!services/order_service/Config.toml
!services/order_service/tests/Config.toml
!services/customer_service/Config.toml
!services/customer_service/tests/Config.toml
!Config.example.toml
!Config.toml.example
!*.example.toml

# Node & package manager directories
node_modules/
.npm/
.pnpm-store/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Web application build outputs
web/**/dist/
web/**/build/
web/**/.next/
web/**/out/
dist/
build/
.next/

# Test coverage & generated execution evidence
coverage/
test-results/
*.log

# Agent & autonomous workflow artifacts
.agents/
scratch/

# Operating system metadata
.DS_Store
Thumbs.db
desktop.ini

# IDE, editor and local workspace configurations
.idea/
*.iml
*.iws
*.ipr
.vscode/
.fleet/
.history/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Local environment caches
.cache/
.env
.env.local
.env.*.local
*.tmp
*.bak
*.swp
*~

# Explicitly preserve canonical seed datasets, scripts and documentation
!data/*.json
!scripts/*.js
!scripts/*.mjs
!scripts/*.sh
!scripts/*.ps1
!docs/**/*.md
